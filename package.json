{
  "name": "specsync",
  "version": "1.0.0",
  "description": "GitHub-native bot that detects API/config changes in PRs and auto-proposes updates to linked Notion spec pages",
  "main": "dist/index.js",
  "bin": {
    "specsync": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.14",
    "@octokit/rest": "^20.0.2",
    "@octokit/webhooks": "^12.0.10",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "minimatch": "^9.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}
